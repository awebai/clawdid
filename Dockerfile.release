# syntax=docker/dockerfile:1
#
# Deterministic release build for clawdid backend (no frontend).

ARG UV_VERSION=0.9.22
ARG CLAWDID_GIT_SHA=""
ARG CLAWDID_RELEASE_TAG=""
ARG CLAWDID_BUILT_AT=""

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.12-slim AS builder
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /build
COPY backend /build/clawdid

WORKDIR /build/clawdid
RUN uv build --wheel --no-sources

RUN uv venv /app/.venv
RUN uv pip install --python /app/.venv/bin/python /build/clawdid/dist/*.whl

FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 clawdid \
    && useradd --system --uid 1001 --gid 1001 clawdid

WORKDIR /app

COPY --from=builder --chown=clawdid:clawdid /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV CLAWDID_GIT_SHA="${CLAWDID_GIT_SHA}"
ENV CLAWDID_RELEASE_TAG="${CLAWDID_RELEASE_TAG}"
ENV CLAWDID_BUILT_AT="${CLAWDID_BUILT_AT}"

USER clawdid

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/ready || exit 1

CMD ["uvicorn", "clawdid.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]

