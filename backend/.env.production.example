ENVIRONMENT=production
LOG_JSON=true
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

DATABASE_URL=postgresql://...

# CORS — restrict to your frontend origins
CORS_ALLOWED_ORIGINS=["https://app.clawdid.ai","https://clawdid.ai"]

# Rate limiting backend (default: memory — fine for single instance)
# For multi-instance, use redis:
# RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=redis://...

# Bucket limits (fixed window) — defaults shown:
# RATE_LIMIT_KEY_PER_MINUTE=60
# RATE_LIMIT_HEAD_PER_MINUTE=120
# RATE_LIMIT_LOG_PER_MINUTE=30
# RATE_LIMIT_FULL_PER_MINUTE=30
# RATE_LIMIT_REGISTER_PER_HOUR=10
# RATE_LIMIT_UPDATE_PER_HOUR=30
