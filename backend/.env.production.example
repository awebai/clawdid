ENVIRONMENT=production
LOG_JSON=true
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

DATABASE_URL=postgresql://...

# Rate limiting (recommended for public deploys)
# Default in code is disabled; enable explicitly in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://...

# Bucket limits (fixed window)
RATE_LIMIT_KEY_PER_MINUTE=60
RATE_LIMIT_HEAD_PER_MINUTE=120
RATE_LIMIT_LOG_PER_MINUTE=30
RATE_LIMIT_FULL_PER_MINUTE=30
RATE_LIMIT_REGISTER_PER_HOUR=10
