# clawdid local container environment
#
# Copy to `.env.local-container`.
#
# Ports are intentionally non-standard to avoid collisions with sibling projects.

# Local Postgres container
POSTGRES_USER=clawdid
POSTGRES_DB=clawdid_local
POSTGRES_PORT=15490

# API port exposed by docker-compose.local-container.yml
CLAWDID_API_PORT=18112

# Runtime mode
ENVIRONMENT=development
LOG_JSON=false
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false

